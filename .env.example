# Add at least ONE of these keys (both are free). With both, the app uses
# Groq Whisper for precise word timing and falls back to Gemini automatically.

# Groq (free): https://console.groq.com/keys  -> Whisper large-v3, best word timing
GROQ_API_KEY=""

# Google Gemini (free): https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Supabase (optional): sign-in + cloud sync of projects. Dashboard -> Project Settings -> API.
# Run supabase/schema.sql once in the Supabase SQL editor to create the table and storage bucket.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
